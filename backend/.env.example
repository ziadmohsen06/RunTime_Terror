PORT=3000
RECURRING_CHECK_INTERVAL_MINUTES=60

# Demo-only route POST /recurring-tasks/run-check. Fine on your own machine; in production
# leave it false (anyone with an account could trigger the weekly generation).
ENABLE_DEMO_ROUTES=true

# Where the SQLite file lives. Default is ./closet.sqlite next to where the server starts.
# On a host, point it at a persistent disk, e.g. /var/data/closet.sqlite
# DATABASE_PATH=./closet.sqlite

# DATABASE_URL=postgres://user:password@localhost:5432/closet

# Secret that signs login tokens. Put a long random value in your own .env (never commit .env).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
